# Variables de entorno — k-hace
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# ── Firebase ────────────────────────────────────────────────
# Consola: https://console.firebase.google.com → Configuración del proyecto
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ── Google Maps ─────────────────────────────────────────────
# Consola: https://console.cloud.google.com → APIs & Services → Credenciales
MAPS_API_KEY=your_google_maps_api_key_here
